{
  "name": "somacampus",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "tsc -b --pretty false",
    "test": "vitest run",
    "test:ci": "vitest run",
    "test:live-e2e": "TEST_LIVE_DB=true vitest run src/test/ai-teaching-loop-e2e.test.ts",
    "test:unit": "vitest run src/test/design-system.test.tsx",
    "test:watch": "vitest",
    "seed:check": "node scripts/validate-seed.mjs",
    "seed:demo:gen": "node scripts/generate-demo-seed.mjs",
    "seed:demo:check": "node scripts/validate-seed.mjs scripts/seed-demo-school.sql",
    "verify:trust": "node .agents/skills/somacampus-verify/scripts/detect-mock-rot.mjs",
    "verify:contracts": "node .agents/skills/somacampus-verify/scripts/audit-db-contracts.mjs",
    "verify:columns": "node .agents/skills/somacampus-verify/scripts/check-service-columns.mjs",
    "verify:migrations": "node .agents/skills/somacampus-verify/scripts/check-migration-sync.mjs",
    "verify:all": "npm run verify:contracts && npm run verify:columns && npm run verify:migrations && npm run typecheck && npm test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.0",
    "@tanstack/react-query": "^5.66.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
