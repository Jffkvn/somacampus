VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- AI provider (server-side only; see docs/AI-PROVIDER-CONFIG.md) ---
# Never prefix these with VITE_: provider secrets live in Supabase Edge
# secrets, never in the browser bundle.
#
# AI_PROVIDER: selects the Edge AI backend. Default 'gemini'.
#   The interface is extensible but only 'gemini' is implemented.
# GEMINI_API_KEY: required. Missing -> Edge returns HTTP 503 AI_PROVIDER_UNCONFIGURED.
# GEMINI_MODEL: required, no default. Missing -> Edge returns HTTP 500 naming GEMINI_MODEL.
#   Set both via Supabase secrets, then redeploy the function:
#   supabase secrets set GEMINI_MODEL=<model> GEMINI_API_KEY=<key>
#   supabase functions deploy ai-teaching-assistant
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
