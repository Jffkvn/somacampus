# SomaCampus — environment template (copy to .env; never commit .env)
# .env is gitignored. Keep secrets out of VITE_* — those ship to the browser.

# --- Browser-safe (Vite) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server-only / scripts (NEVER prefix with VITE_) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI Gateway (Supabase Edge Function secrets — prefer `supabase secrets set`) ---
# Local edge serve may read these; production uses Dashboard → Edge Functions → Secrets.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# OpenAI alternative (AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Recording webhook (Meet/Zoom) — also an edge function secret in production
RECORDING_WEBHOOK_SECRET=

# Optional: live DB test gate
# TEST_LIVE_DB=true
