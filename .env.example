# SomaCampus — environment template (copy to .env; never commit .env)
# .env is gitignored. Keep secrets out of VITE_* — those ship to the browser.

# --- Browser-safe (Vite) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Server-only / scripts (NEVER prefix with VITE_) ---
# Used by seed/verify scripts and any backend/edge function.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Future LLM / paper-draft backend (server-only — not VITE_)
# PAPER_AI_API_KEY=
# PAPER_AI_BASE_URL=
# PAPER_AI_MODEL=

# Optional: live DB test gate
# TEST_LIVE_DB=true
